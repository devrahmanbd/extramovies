---
import Admin from "../../layouts/Admin.astro";
import { getSession, getSessionToken } from "../../lib/auth/session";
import { getDb } from "../../lib/db/adapter";
import { listFlagged } from "../../lib/members/moderation";

export const prerender = false;

const token = getSessionToken(Astro.cookies as never);
const session = getSession(token);
if (!session) {
  const next = Astro.url.pathname + Astro.url.search;
  return Astro.redirect(`/admin/login?next=${encodeURIComponent(next)}`);
}

let flagged: Awaited<ReturnType<typeof listFlagged>> = [];
try {
  flagged = await listFlagged(getDb({}) as never);
} catch {
  flagged = [];
}
---
<Admin email={session.email} csrfToken={session.csrfToken} current="/admin/moderation">
  <section class="card">
    <h2>Flagged member reviews</h2>
    {flagged.length === 0 ? (
      <p class="muted">No flagged reviews. Reports from members will appear here.</p>
    ) : (
      <ul class="list" data-mod-list>
        {flagged.map((f) => (
          <li data-mod-row={f.id}>
            <a href={`/movies/${f.tmdbId}`}>Title #{f.tmdbId}</a>
            <span class="muted small">{f.title ? ` — ${f.title}` : ""}</span>
            <span class="muted small"> by {f.displayName || (f.handle ? `@${f.handle}` : "Member")}</span>
            <span class="badge">{f.reports} report{f.reports === 1 ? "" : "s"}</span>
            <span class={`badge ${f.status}`}>{f.status}</span>
            <span class="muted small tnum">{f.createdAt?.slice(0, 10)}</span>
            <button
              type="button"
              class="btn ghost"
              data-mod-btn
              data-mod-id={f.id}
              data-mod-action={f.status === "hidden" ? "show" : "hide"}
            >{f.status === "hidden" ? "Show" : "Hide"}</button>
          </li>
        ))}
      </ul>
    )}
  </section>
  <script is:inline define:vars={{ csrfToken: session.csrfToken }}>
    (() => {
      const bind = (btn) => {
        if (btn.dataset.modBound === "true") return;
        btn.dataset.modBound = "true";
        btn.addEventListener("click", async () => {
          const id = btn.dataset.modId || "";
          const action = btn.dataset.modAction || "hide";
          btn.disabled = true;
          try {
            const res = await fetch("/api/admin/moderation", {
              method: "POST",
              headers: { "Content-Type": "application/json", ...(csrfToken ? { "x-csrf-token": csrfToken } : {}) },
              body: JSON.stringify({ action, id }),
            });
            if (!res.ok) return;
            window.location.reload();
          } finally {
            btn.disabled = false;
          }
        });
      };
      document.querySelectorAll("[data-mod-btn]").forEach(bind);
    })();
  </script>
</Admin>
