---
/** Base layout — every public page flows through here and reads getBrand(). */
import "../styles/tokens.css";
import "../styles/global.css";
import { getSiteBrand } from "../lib/seo/brand";
import { getSetting } from "../lib/db/adapter";
import { buildPageMeta, siteOrigin } from "../lib/seo/meta";
import type { JsonLd } from "../lib/seo/jsonld";
import type { HeroImagePreload } from "../lib/seo/hero-image";
import { withFontDisplaySwap } from "../lib/seo/fonts";
import SiteHeader from "../components/public/SiteHeader.astro";
import { getSession, getSessionToken, sessionDbFromAstro } from "../lib/auth/session";
import { getUserById } from "../lib/users/store";
import { getDb } from "../lib/db/adapter";
import { currentTheme } from "../lib/tmdb/discover";
import SiteFooter from "../components/public/SiteFooter.astro";
import { listGenres } from "../lib/seo/content";
import { siteId } from "../lib/seo/store-merge";

interface Props {
  title: string;
  description?: string;
  descriptionExtra?: string;
  path?: string;
  image?: string | null;
  imageAlt?: string;
  robots?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  jsonld?: JsonLd[];
  current?: string;
  /** Hero artwork to preload (LCP). Size pair included only when known. */
  preloadImage?: HeroImagePreload | null;
}

const {
  title,
  description,
  descriptionExtra,
  image,
  imageAlt,
  robots = "index, follow",
  ogType = "website",
  publishedTime,
  modifiedTime,
  jsonld = [],
  current = "",
  preloadImage = null,
} = Astro.props;

const brand = await getSiteBrand((k) => getSetting(getDb({}), k));
let theme: string = "publication";
try {
  theme = await currentTheme();
} catch {
  theme = "publication";
}
const origin = siteOrigin(Astro.url.origin);
const path = Astro.props.path ?? Astro.url.pathname;
const showUmamiTracker = import.meta.env.PROD && siteId() === "extramovies";
const meta = buildPageMeta({
  brand,
  title,
  descriptionSource: description ?? brand.description,
  descriptionExtra,
  path,
  origin,
});
const rawOgImage = image ?? brand.defaultOgImage ?? null;
// og:image must be absolute for scrapers; brand art is root-relative
// (multi-site safe), so prefix the request origin when needed.
const ogImage =
  rawOgImage && !/^https?:\/\//i.test(rawOgImage)
    ? `${origin.replace(/\/$/, "")}${rawOgImage.startsWith("/") ? rawOgImage : `/${rawOgImage}`}`
    : rawOgImage;
const brandVars = [
  `--brand-accent:${brand.colors.accent}`,
  `--brand-accent-ink:${brand.colors.accentInk}`,
  `--brand-gold:${brand.colors.gold}`,
  `--font-display:${brand.fonts.display}`,
  `--font-body:${brand.fonts.body}`,
].join(";");
const FALLBACK_FONT_URL =
  "https://fonts.googleapis.com/css2?family=Anton&family=Lato:wght@400;700;900&display=swap";
// The stylesheet is loaded print-to-all (never render-blocking); display=swap
// keeps the text painted with fallback type while the font is in flight.
const fontHref = withFontDisplaySwap(brand.fonts.fontUrl) ?? FALLBACK_FONT_URL;
const fallbackFontHref = withFontDisplaySwap(FALLBACK_FONT_URL) ?? FALLBACK_FONT_URL;
const genres = listGenres();
// Member state for the nav (best-effort; pages render identically anonymous).
let member: { handle: string; displayName: string } | null = null;
let memberCsrf = "";
try {
  const sess = await getSession(getSessionToken(Astro.cookies as never), sessionDbFromAstro(Astro));
  if (sess && sess.role === "member" && sess.userId) {
    memberCsrf = sess.csrfToken;
    try {
      const u = await getUserById(getDb({}), sess.userId);
      if (u) member = { handle: u.handle, displayName: u.displayName };
    } catch {
      /* DB unavailable — stay anonymous */
    }
  }
} catch {
  /* never break page render for nav state */
}
---
<!DOCTYPE html>
<html lang="en" style={brandVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.seoTitle}</title>
    <meta name="description" content={meta.metaDesc} />
    <link rel="canonical" href={meta.canonical} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content={brand.themeColor} />
    {preloadImage ? (
      <link
        {...{
          rel: "preload",
          as: "image",
          href: preloadImage.href,
          // width/height on a preload link let the browser reserve the box
          // before the bytes land; Astro's link typing omits them, hence the
          // attribute spread.
          width: preloadImage.width,
          height: preloadImage.height,
          fetchpriority: "high",
        }}
      />
    ) : null}
    {brand.fonts.fontUrl ? (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href={fontHref} media="print" onload="this.media='all'" />
      </>
    ) : (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href={fallbackFontHref} media="print" onload="this.media='all'" />
      </>
    )}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={meta.seoTitle} />
    <meta property="og:description" content={meta.metaDesc} />
    <meta property="og:url" content={meta.canonical} />
    <meta property="og:locale" content={brand.locale} />
    {ogImage ? <meta property="og:image" content={ogImage} /> : null}
    {ogImage && imageAlt ? <meta property="og:image:alt" content={imageAlt} /> : null}
    {ogType === "article" && publishedTime ? (
      <meta property="article:published_time" content={publishedTime} />
    ) : null}
    {ogType === "article" && modifiedTime ? (
      <meta property="article:modified_time" content={modifiedTime} />
    ) : null}

    <meta
      name="twitter:card"
      content={ogImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={meta.seoTitle} />
    <meta name="twitter:description" content={meta.metaDesc} />
    {ogImage ? <meta name="twitter:image" content={ogImage} /> : null}

    <link rel="icon" href={brand.favicon ?? brand.icon} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${brand.name} — latest reviews`}
      href={`${origin}/rss.xml`}
    />
    {jsonld.map((node) => (
      <script type="application/ld+json" set:html={JSON.stringify(node)} />
    ))}
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t === "dark" || t === "light") {
          document.documentElement.dataset.theme = t;
        }
      } catch (e) {}
    </script>
    {showUmamiTracker ? <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="11536ca4-956e-4248-b761-9e7ee5269fc0"></script> : null}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader brand={brand} current={current} member={member} csrfToken={memberCsrf} theme={theme} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter brand={brand} genres={genres} />
  </body>
</html>
