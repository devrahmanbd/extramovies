---
/**
 * Editorial list body — the supporting content type behind /lists.
 *
 * A list is a curated, ranked set of reviews the site already publishes.
 * Nothing here invents a film, a score or a verdict: every row comes from
 * resolveListItems(), which drops an unpublished or unscored slug. The page
 * carries CollectionPage + ItemList + BreadcrumbList, the same shapes the
 * taxonomy pages use, and no FAQ/HowTo markup.
 */
import Base from "../../layouts/Base.astro";
import TaxonomyReviewItem from "./TaxonomyReviewItem.astro";
import {
  listIsIndexable,
  listJsonLd,
  listPath,
  type EditorialList,
  type ResolvedListItem,
} from "../../lib/seo/lists";

interface RelatedListLink {
  title: string;
  path: string;
  count: number;
}

interface RelatedCategoryLink {
  label: string;
  path: string;
  count: number;
}

interface Props {
  list: EditorialList;
  items: ResolvedListItem[];
  relatedLists: RelatedListLink[];
  relatedCategories: RelatedCategoryLink[];
  origin: string;
  theme: string;
}

const { list, items, relatedLists, relatedCategories, origin, theme } = Astro.props;
const isDiscovery = theme === "discovery";
const indexable = listIsIndexable(items);
const headingIsLong = list.title.length > 40;
const lead = items[0]?.review;
const image = lead?.backdropUrl ?? lead?.posterUrl ?? null;
const countText = items.length === 1 ? "1 film" : `${items.length} films`;
const jsonld = listJsonLd(list, items, origin);
const hasRelated = relatedLists.length > 0 || relatedCategories.length > 0;
---
<Base
  title={list.seoTitle}
  seoTitle={list.seoTitle}
  description={list.description}
  descriptionExtra="Ranked by our own verdicts, with the full review linked for every entry."
  path={listPath(list.slug)}
  image={image}
  imageAlt={lead ? `${lead.movieTitle} artwork` : undefined}
  robots={indexable ? "index, follow" : "noindex, follow"}
  jsonld={jsonld}
  current="lists"
>
  {isDiscovery ? (
  <>
  <div class="wrap">
    <section class="band section--md d-browse-head" aria-labelledby="list-title">
      <nav class="d-crumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true"> / </span><a href="/lists">Lists</a><span aria-hidden="true"> / </span><span aria-current="page">{list.title}</span>
      </nav>
      <p class="d-kicker">Editorial list</p>
      <h1 id="list-title" class={headingIsLong ? "display--long" : undefined}>{list.title}</h1>
      <p class="d-lede tnum">{countText}, ranked by our verdicts. Updated {list.updatedLabel}.</p>
      {list.intro.map((paragraph) => <p class="d-lede">{paragraph}</p>)}
    </section>

    <section class="band--alt section--md d-results" aria-labelledby="list-items-heading">
      <div class="section-head d-section-row">
        <div>
          <h2 id="list-items-heading" class="tnum">{countText}</h2>
          <p>The score is the review's own rating. The link goes to the full review.</p>
        </div>
      </div>
      <ol class="glam-archive">
        {items.map((item, i) => <TaxonomyReviewItem review={item.review} index={i} />)}
      </ol>
      {!indexable ? (
        <p class="d-lede">This list is still growing. It becomes a permanent part of the archive once it has at least three published reviews.</p>
      ) : null}
    </section>

    <section class="band section--sm" aria-labelledby="list-method-heading">
      <div class="section-head">
        <h2 id="list-method-heading">How this list was chosen</h2>
        <p>{list.method}</p>
      </div>
      <p><a href="/reviews">Browse the full review archive</a> or <a href="/lists">see every editorial list</a>.</p>
    </section>

    {hasRelated ? (
    <section class="band--alt section--sm" aria-labelledby="list-related-heading">
      <div class="section-head">
        <h2 id="list-related-heading">Read next</h2>
        <p>Other lists and archives built from the same reviews.</p>
      </div>
      {relatedLists.length > 0 ? (
        <nav class="glam-genres" aria-label="Related lists">
          <ul>
            {relatedLists.map((link, i) => (
              <li>
                <a href={link.path}>{link.title}</a>
                <span class="tnum"> ({link.count})</span>
                {i < relatedLists.length - 1 ? <span class="glam-genres-sep" aria-hidden="true">/</span> : null}
              </li>
            ))}
          </ul>
        </nav>
      ) : null}
      {relatedCategories.length > 0 ? (
        <nav class="glam-genres" aria-label="Related categories">
          <ul>
            {relatedCategories.map((link, i) => (
              <li>
                <a href={link.path}>{link.label} reviews</a>
                {i < relatedCategories.length - 1 ? <span class="glam-genres-sep" aria-hidden="true">/</span> : null}
              </li>
            ))}
          </ul>
        </nav>
      ) : null}
    </section>
    ) : null}
  </div>
  </>
  ) : (
  <>
  <div class="wrap">
    <section aria-labelledby="list-title" class="band section--lg glam-archive-head">
      <div class="section-head">
        <nav class="glam-genres" aria-label="Breadcrumb">
          <ul>
            <li><a href="/">Home</a><span class="glam-genres-sep" aria-hidden="true">/</span></li>
            <li><a href="/lists">Lists</a><span class="glam-genres-sep" aria-hidden="true">/</span></li>
            <li><span aria-current="page">{list.title}</span></li>
          </ul>
        </nav>
        <p class="glam-kicker tnum">Editorial list</p>
        <h1 id="list-title" class={headingIsLong ? "display--long" : undefined}>{list.title}</h1>
        <p class="tnum glam-archive-dek">{countText}, ranked by our verdicts. Updated {list.updatedLabel}.</p>
        {list.intro.map((paragraph) => <p class="glam-archive-dek">{paragraph}</p>)}
      </div>
    </section>
  </div>

  <div class="band section--md glam-archive-band">
    <div class="wrap">
      <ol class="glam-archive">
        {items.map((item, i) => <TaxonomyReviewItem review={item.review} index={i} />)}
      </ol>
      {!indexable ? (
        <p class="glam-archive-dek">This list is still growing. It becomes a permanent part of the archive once it has at least three published reviews.</p>
      ) : null}
    </div>
  </div>

  <section class="band section--sm" aria-labelledby="list-method-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="list-method-heading">How this list was chosen</h2>
        <p>{list.method}</p>
      </div>
      <p><a href="/reviews">Browse the full review archive</a> or <a href="/lists">see every editorial list</a>.</p>
    </div>
  </section>

  {hasRelated ? (
  <section class="band--alt section--sm" aria-labelledby="list-related-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="list-related-heading">Read next</h2>
        <p>Other lists and archives built from the same reviews.</p>
      </div>
      {relatedLists.length > 0 ? (
        <nav class="glam-genres" aria-label="Related lists">
          <ul>
            {relatedLists.map((link, i) => (
              <li>
                <a href={link.path}>{link.title}</a>
                <span class="tnum"> ({link.count})</span>
                {i < relatedLists.length - 1 ? <span class="glam-genres-sep" aria-hidden="true">/</span> : null}
              </li>
            ))}
          </ul>
        </nav>
      ) : null}
      {relatedCategories.length > 0 ? (
        <nav class="glam-genres" aria-label="Related categories">
          <ul>
            {relatedCategories.map((link, i) => (
              <li>
                <a href={link.path}>{link.label} reviews</a>
                {i < relatedCategories.length - 1 ? <span class="glam-genres-sep" aria-hidden="true">/</span> : null}
              </li>
            ))}
          </ul>
        </nav>
      ) : null}
    </div>
  </section>
  ) : null}
  </>
  )}
</Base>
