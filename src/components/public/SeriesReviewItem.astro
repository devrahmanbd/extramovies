---
/**
 * One series review in the /series index — the facts the index owes the
 * reader: the review's own title, the title and year of the series, our
 * rating, our one-line verdict, a link to the review and a link to the
 * series hub (the guide page with the credits and where to watch).
 *
 * Nothing is added that the review row does not already carry, and the hub
 * link appears only when the row has a TMDB id to point at.
 */
import type { PublicReview } from "../../lib/seo/content";
import { seriesHubPath } from "../../lib/seo/series-reviews";
import RatingMark from "./RatingMark.astro";

interface Props {
  review: PublicReview;
  index?: number;
}

const { review, index } = Astro.props;
const url = `/reviews/${review.slug}`;
const hub = seriesHubPath(review);
const num = typeof index === "number" ? String(index + 1).padStart(2, "0") : null;
const meta = [review.movieTitle, review.year ? String(review.year) : null]
  .filter(Boolean)
  .join(" — ");
const summary = review.verdict || review.excerpt;
---
<li class="glam-item glam-terse">
  {num ? <span class="glam-num" aria-hidden="true">{num}</span> : null}
  <div class="glam-terse-main">
    <h3 class="glam-terse-title">
      <a href={url}>{review.reviewTitle}</a>
    </h3>
    {meta ? <p class="glam-meta tnum">{meta}</p> : null}
    {summary ? <p class="glam-verdict">{summary}</p> : null}
    <p class="glam-more">
      <a href={url}>Read the review</a>
      {hub ? <> · <a href={hub}>Series guide</a></> : null}
    </p>
  </div>
  <RatingMark rating={review.rating} />
</li>
