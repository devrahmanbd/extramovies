---
import { getTileBadge } from "../../lib/badges";
import { tmdbSrcSet, TMDB_POSTER_SIZES } from "../../lib/seo/images";
/** Poster tile — links to the discovery detail page. Zero JS.
 * Streaming-guide rebuild: full 2:3 posters (w342, object-fit contain via
 * global), small neutral title/year/score, 44px link targets (CSS), lazy art
 * below the fold (eager only for lead/above-fold). Single h1 lives in the
 * page hero — tiles carry no headings. No data claims beyond TMDB fields.
 */
interface Props {
  tmdbId: number;
  title: string;
  year: number | null;
  posterUrl: string | null;
  rating: number | null;
  /** "tmdb" (default) or "ours" (author's own score on local reviews). */
  source?: "tmdb" | "ours";
  href?: string;
  /** Density variant: rail (snap rail) | lead (large feature) | compact (dense flow). */
  variant?: "rail" | "lead" | "compact";
  /** Override lazy art (true = eager above the fold). Defaults to lead-only. */
  eager?: boolean;
}
const { tmdbId, title, year, posterUrl, rating, source = "tmdb", href, variant = "rail", eager } = Astro.props;
const tileBadge = getTileBadge(tmdbId);
const link = href ?? `/movies/${tmdbId}`;
const isLong = title.length > 40;
const isLead = variant === "lead";
const isEager = typeof eager === "boolean" ? eager : isLead;
const ratingText =
  rating === null
    ? null
    : source === "ours"
      ? `Our rating ${rating.toFixed(1)}/10`
      : `TMDB ${rating.toFixed(1)}`;
const metaLine = [year !== null ? String(year) : null, ratingText]
  .filter((s): s is string => s !== null)
  .join("  ·  ");
/**
 * Responsive poster candidates (w185/w342/w500). The rail slot is a fixed
 * ~120px track (`.d-guide-rail`, global.css); the compact slot is the 3/5/6
 * column guide grid (117px → 182px → 154px). The lead variant renders at
 * 780px wide, so it is excluded: w500 would soften it.
 * A non-TMDB or missing poster yields null, which keeps the plain src.
 */
const posterSrcSet = isLead ? null : tmdbSrcSet(posterUrl, TMDB_POSTER_SIZES);
const posterSizes =
  variant === "compact"
    ? "(min-width: 64rem) 154px, (min-width: 48rem) 182px, 117px"
    : "120px";
---
<li class={`d-tile is-${variant}`}>
  <a href={link}>
    {posterUrl ? (
      <img
        src={posterUrl}
        srcset={posterSrcSet ?? undefined}
        sizes={posterSrcSet ? posterSizes : undefined}
        alt={`Poster for ${title}`}
        width={isLead ? "780" : "342"}
        height={isLead ? "1170" : "513"}
        loading={isEager ? "eager" : "lazy"}
        fetchpriority={isEager ? "high" : undefined}
        decoding="async"
      />
    ) : (
      <span class="d-tile-fallback" aria-hidden="true">{title.charAt(0) || "•"}</span>
    )}
    {tileBadge ? (
      <span class="title-badges" aria-hidden="true">
        {tileBadge === "platformPick" ? <span class="platform-pick">Platform Pick</span> : <span class="title-reviewed">Reviewed</span>}
      </span>
    ) : null}
    <span class="d-tile-text">
      <span class={`d-tile-title${isLong ? " display--long" : ""}`}>{title}</span>
      {metaLine ? <span class="d-tile-meta tnum">{metaLine}</span> : null}
    </span>
  </a>
</li>
