---
/** Search — server-rendered, no JS. Indexed out of robots via noindex. */
import Base from "../layouts/Base.astro";
import ReviewCard from "../components/public/ReviewCard.astro";
import MovieTile from "../components/discover/MovieTile.astro";
import SearchForm from "../components/public/SearchForm.astro";
import { breadcrumbJsonLd } from "../lib/seo/jsonld";
import { siteOrigin } from "../lib/seo/meta";
import { getSiteBrand } from "../lib/seo/brand";
import { getDb, getSetting } from "../lib/db/adapter";
import { searchReviews } from "../lib/seo/content";
import { mapShowToTile, searchMoviesByTitle, searchShowsByTitle } from "../lib/tmdb/client";
import { mapToTile, currentTheme } from "../lib/tmdb/discover";

let theme: string = "publication";
try {
  theme = await currentTheme();
} catch {
  theme = "publication";
}
const isPublication = theme !== "discovery";

const brand = await getSiteBrand((k) => getSetting(getDb({}), k));
const origin = siteOrigin(Astro.url.origin);
const query = (Astro.url.searchParams.get("q") ?? "").trim().slice(0, 120);
const typeParam = (Astro.url.searchParams.get("type") ?? "all").trim().toLowerCase();
const activeType = typeParam === "movie" || typeParam === "series" || typeParam === "review" ? typeParam : "all";
const showMovies = !isPublication && (activeType === "all" || activeType === "movie");
const showSeries = !isPublication && (activeType === "all" || activeType === "series");
const showReviews = isPublication ? true : (activeType === "all" || activeType === "review");
const results = query && showReviews ? searchReviews(query) : [];
const movieTiles = query && showMovies ? (await searchMoviesByTitle(query)).slice(0, 20).map(mapToTile) : [];
const seriesTiles = query && showSeries ? (await searchShowsByTitle(query)).slice(0, 20).map(mapShowToTile) : [];
const jsonld = [breadcrumbJsonLd(origin, [{ name: "Home", path: "/" }, { name: "Search", path: "/search" }])];
const searchTitle = query ? `Search: ${query}` : "Search";
const searchTitleIsLong = searchTitle.length > 40;
const chipHref = (t: string) => `/search?q=${encodeURIComponent(query)}${t === "all" ? "" : `&type=${t}`}`;
const MOVIE_SHOW = 6;
const movieHead = movieTiles.slice(0, MOVIE_SHOW);
const movieRest = movieTiles.slice(MOVIE_SHOW);
const SERIES_SHOW = 6;
const seriesHead = seriesTiles.slice(0, SERIES_SHOW);
const seriesRest = seriesTiles.slice(SERIES_SHOW);
---
<Base
  title={searchTitle}
  description={`Search movies and series (TMDB) and the review archive by title, genre, or year.`}
  path="/search"
  robots="noindex, follow"
  jsonld={jsonld}
  current="search"
>
  <div class="wrap">
    <section aria-labelledby="search-title" class="band section--lg glam-search-head">
      <div class="section-head">
        <p class="glam-kicker tnum">Index search</p>
        <h1 id="search-title" class={searchTitleIsLong ? "display--long" : undefined}>Search</h1>
      </div>
      <SearchForm query={query} />
      {query ? (
        isPublication ? (
          <p role="status" class="tnum">
            {results.length} {results.length === 1 ? "review" : "reviews"} for{" "}
            “{query}”.
          </p>
        ) : (
          <p role="status" class="tnum">
            {movieTiles.length} {movieTiles.length === 1 ? "movie" : "movies"} ·{" "}
            {seriesTiles.length} series for
            {" "}“{query}” ·{" "}
            {results.length} {results.length === 1 ? "review" : "reviews"}.
          </p>
        )
      ) : (
        <p>Try a film or show title, a genre like “Drama”, or a year like “2024”.</p>
      )}
      {query && !isPublication ? (
        <nav class="d-search-filters" aria-label="Filter results">
          <a href={chipHref("all")} aria-current={activeType === "all" ? "page" : undefined}>All</a>
          <a href={chipHref("movie")} aria-current={activeType === "movie" ? "page" : undefined}>Movies ({movieTiles.length})</a>
          <a href={chipHref("series")} aria-current={activeType === "series" ? "page" : undefined}>Series ({seriesTiles.length})</a>
          <a href={chipHref("review")} aria-current={activeType === "review" ? "page" : undefined}>Reviews ({results.length})</a>
        </nav>
      ) : null}
    </section>
  </div>

  {query && showMovies ? (
    <div class="band section--md glam-search-band">
      <div class="wrap">
        <div class="section-head">
          <h2 id="search-movies-heading">Movies</h2>
        </div>
        {movieTiles.length > 0 ? (
          <>
            <ol class="d-guide-grid">
              {movieHead.map((t, i) => (
                <MovieTile
                  tmdbId={t.tmdbId}
                  title={t.title}
                  year={t.year}
                  posterUrl={t.posterUrl}
                  rating={t.rating}
                  source="tmdb"
                  href={`/movies/${t.tmdbId}`}
                  variant="compact"
                  eager={i === 0}
                />
              ))}
            </ol>
            {movieRest.length > 0 ? (
              <details class="d-search-more">
                <summary>Show all {movieTiles.length} movies</summary>
                <ol class="d-guide-grid">
                  {movieRest.map((t) => (
                    <MovieTile
                      tmdbId={t.tmdbId}
                      title={t.title}
                      year={t.year}
                      posterUrl={t.posterUrl}
                      rating={t.rating}
                      source="tmdb"
                      href={`/movies/${t.tmdbId}`}
                      variant="compact"
                    />
                  ))}
                </ol>
              </details>
            ) : null}
          </>
        ) : (
          <p>No movies matched “{query}” (or TMDB is unreachable).</p>
        )}
      </div>
    </div>
  ) : null}

  {query && showSeries ? (
    <div class="band section--md glam-search-band">
      <div class="wrap">
        <div class="section-head">
          <h2 id="search-series-heading">Series</h2>
        </div>
        {seriesTiles.length > 0 ? (
          <>
            <ol class="d-guide-grid">
              {seriesHead.map((t, i) => (
                <MovieTile
                  tmdbId={t.tmdbId}
                  title={t.title}
                  year={t.year}
                  posterUrl={t.posterUrl}
                  rating={t.rating}
                  source="tmdb"
                  href={`/series/${t.tmdbId}`}
                  variant="compact"
                  eager={i === 0}
                />
              ))}
            </ol>
            {seriesRest.length > 0 ? (
              <details class="d-search-more">
                <summary>Show all {seriesTiles.length} series</summary>
                <ol class="d-guide-grid">
                  {seriesRest.map((t) => (
                    <MovieTile
                      tmdbId={t.tmdbId}
                      title={t.title}
                      year={t.year}
                      posterUrl={t.posterUrl}
                      rating={t.rating}
                      source="tmdb"
                      href={`/series/${t.tmdbId}`}
                      variant="compact"
                    />
                  ))}
                </ol>
              </details>
            ) : null}
          </>
        ) : (
          <p>No series matched “{query}” (or TMDB is unreachable).</p>
        )}
      </div>
    </div>
  ) : null}

  {query && showReviews ? (
    <div class="band section--md glam-search-band">
      <div class="wrap">
        <div class="section-head">
          <h2 id="search-reviews-heading">Reviews</h2>
        </div>
        {results.length > 0 ? (
          <ol class="glam-results">
            {results.map((r, i) => <ReviewCard review={r} index={i} variant="search" showExcerpt={true} />)}
          </ol>
        ) : (
          <p>Nothing matched. <a href="/reviews">Browse the full archive</a> instead.</p>
        )}
      </div>
    </div>
  ) : null}
</Base>
