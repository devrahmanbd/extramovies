---
/**
 * /lists — the editorial-list hub (TM-3, QS-3).
 *
 * A list is a curated reading path through the site's own published reviews.
 * The hub shows only lists that clear LIST_MIN_INDEXABLE, so a brand with a
 * thin archive never advertises a one-item list. The genre block links to
 * every category hub the archive actually publishes, including the thin
 * clusters that need internal links (TM-4).
 */
import Base from "../../layouts/Base.astro";
import { getLatestReviews } from "../../lib/seo/content";
import { siteOrigin } from "../../lib/seo/meta";
import { breadcrumbJsonLd } from "../../lib/seo/jsonld";
import { currentTheme } from "../../lib/tmdb/discover";
import { taxonomyEntries } from "../../lib/seo/taxonomy";
import {
  editorialLists,
  listIsIndexable,
  listPath,
  resolveListItems,
} from "../../lib/seo/lists";

const reviews = getLatestReviews(5000);
const entries = editorialLists()
  .map((list) => ({ list, items: resolveListItems(list, reviews) }))
  .filter(({ items }) => listIsIndexable(items));
const categories = taxonomyEntries("category")
  .filter((entry) => entry.reviews.length >= 1)
  .sort(
    (a, b) =>
      b.reviews.length - a.reviews.length || a.label.localeCompare(b.label),
  );
const origin = siteOrigin(Astro.url.origin);
let theme: string = "publication";
try {
  theme = await currentTheme();
} catch {
  theme = "publication";
}
const isDiscovery = theme === "discovery";
const indexable = entries.length > 0;
const hubTitle = "Film lists and ranked reviews";
const hubDescription =
  "Curated film lists from the review archive: the best films of 2026, Indian cinema and action movies, ranked by our own verdicts and linked to full reviews.";
const jsonld = [
  breadcrumbJsonLd(origin, [
    { name: "Home", path: "/" },
    { name: "Lists", path: "/lists" },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Editorial lists",
    description: hubDescription,
    url: `${origin}/lists`,
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: entries.length,
      itemListElement: entries.map(({ list }, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: list.title,
        url: `${origin}${listPath(list.slug)}`,
      })),
    },
  },
];
---
<Base
  title={hubTitle}
  description={hubDescription}
  descriptionExtra="Every entry links to the full review and the score the review already carries."
  path="/lists"
  robots={indexable ? "index, follow" : "noindex, follow"}
  jsonld={jsonld}
  current="lists"
>
  {isDiscovery ? (
  <>
  <div class="wrap">
    <section class="band section--md d-browse-head" aria-labelledby="lists-title">
      <nav class="d-crumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true"> / </span><span aria-current="page">Lists</span>
      </nav>
      <p class="d-kicker">Editorial lists</p>
      <h1 id="lists-title">Film lists, ranked by our verdicts</h1>
      <p class="d-lede tnum">Curated lists built from the review archive. Every entry links to a full review, and every ranking uses the score the review already carries.</p>
    </section>

    <section class="band--alt section--md d-results" aria-labelledby="lists-index-heading">
      <div class="section-head d-section-row">
        <div>
          <h2 id="lists-index-heading" class="tnum">{entries.length} {entries.length === 1 ? "list" : "lists"}</h2>
          <p>A list is a reading path through the archive, not a new review.</p>
        </div>
      </div>
      <ol class="glam-archive">
        {entries.map(({ list, items }, i) => (
          <li class="glam-item glam-terse">
            <span class="glam-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <div class="glam-terse-main">
              <h3 class="glam-terse-title"><a href={listPath(list.slug)}>{list.title}</a></h3>
              <p class="glam-meta tnum">{items.length} {items.length === 1 ? "film" : "films"}, updated {list.updatedLabel}</p>
              <p class="glam-verdict">{list.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="band section--sm" aria-labelledby="lists-method-heading">
      <div class="section-head">
        <h2 id="lists-method-heading">How lists work</h2>
        <p>Every list is built from reviews already published on the site. We rank by the score the review earned, not by box office, studio or release date. A list only appears here when it has at least three published reviews, and it is refreshed when a new review earns a place. If a review is unpublished, its entry leaves the list.</p>
      </div>
      <p><a href="/reviews">Browse the full review archive</a> or read the <a href="/editorial-policy">editorial policy</a>.</p>
    </section>

    <section class="band--alt section--sm" aria-labelledby="lists-genres-heading">
      <div class="section-head">
        <h2 id="lists-genres-heading">Browse by genre</h2>
        <p>Every genre archive is built from the same reviews. Start with the full category hub if you want the complete list rather than a ranking.</p>
      </div>
      <nav class="glam-genres" aria-label="Browse by genre">
        <ul>
          {categories.map((entry, i) => (
            <li>
              <a href={entry.path}>{entry.label} reviews</a>
              <span class="tnum"> ({entry.reviews.length})</span>
              {i < categories.length - 1 ? <span class="glam-genres-sep" aria-hidden="true">/</span> : null}
            </li>
          ))}
        </ul>
      </nav>
    </section>
  </div>
  </>
  ) : (
  <>
  <div class="wrap">
    <section aria-labelledby="lists-title" class="band section--lg glam-archive-head">
      <div class="section-head">
        <nav class="glam-genres" aria-label="Breadcrumb">
          <ul>
            <li><a href="/">Home</a><span class="glam-genres-sep" aria-hidden="true">/</span></li>
            <li><span aria-current="page">Lists</span></li>
          </ul>
        </nav>
        <p class="glam-kicker tnum">Editorial lists</p>
        <h1 id="lists-title">Film lists, ranked by our verdicts</h1>
        <p class="tnum glam-archive-dek">Curated lists built from the review archive. Every entry links to a full review, and every ranking uses the score the review already carries.</p>
      </div>
    </section>
  </div>

  <div class="band section--md glam-archive-band">
    <div class="wrap">
      <ol class="glam-archive">
        {entries.map(({ list, items }, i) => (
          <li class="glam-item glam-terse">
            <span class="glam-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <div class="glam-terse-main">
              <h3 class="glam-terse-title"><a href={listPath(list.slug)}>{list.title}</a></h3>
              <p class="glam-meta tnum">{items.length} {items.length === 1 ? "film" : "films"}, updated {list.updatedLabel}</p>
              <p class="glam-verdict">{list.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <section class="band section--sm" aria-labelledby="lists-method-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="lists-method-heading">How lists work</h2>
        <p>Every list is built from reviews already published on the site. We rank by the score the review earned, not by box office, studio or release date. A list only appears here when it has at least three published reviews, and it is refreshed when a new review earns a place. If a review is unpublished, its entry leaves the list.</p>
      </div>
      <p><a href="/reviews">Browse the full review archive</a> or read the <a href="/editorial-policy">editorial policy</a>.</p>
    </div>
  </section>

  <section class="band--alt section--sm" aria-labelledby="lists-genres-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="lists-genres-heading">Browse by genre</h2>
        <p>Every genre archive is built from the same reviews. Start with the full category hub if you want the complete list rather than a ranking.</p>
      </div>
      <nav class="glam-genres" aria-label="Browse by genre">
        <ul>
          {categories.map((entry, i) => (
            <li>
              <a href={entry.path}>{entry.label} reviews</a>
              <span class="tnum"> ({entry.reviews.length})</span>
              {i < categories.length - 1 ? <span class="glam-genres-sep" aria-hidden="true">/</span> : null}
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>
  </>
  )}
</Base>
