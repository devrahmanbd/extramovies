---
/**
 * /series — the index of our published SERIES reviews, newest first.
 *
 * WHY THE PAGE EXISTS: the site's brand query ("extramovies web series")
 * has no answer box, so it needs a real page to land on. The series hubs
 * (/series/<tmdbId>) already exist; this is the index that ties them to the
 * reviews we published about them.
 *
 * THE DATA: the published store rows, filtered to the reviews whose subject
 * is a series (src/lib/seo/series-reviews.ts). No title list is maintained
 * here and a row that is not published never appears.
 *
 * INDEXING: a page with at least one published series review is
 * `index, follow`. A page with none still renders (an honest empty state,
 * never a blank page) and is `noindex, follow` — the same thin-page rule
 * the taxonomy pages follow (src/lib/seo/taxonomy.ts).
 *
 * The intro states what the section is and nothing else: no collection
 * size, no "everything" claim, nothing the data does not say.
 */
import Base from "../../layouts/Base.astro";
import SeriesReviewItem from "../../components/public/SeriesReviewItem.astro";
import { getSiteBrand } from "../../lib/seo/brand";
import { getDb, getSetting } from "../../lib/db/adapter";
import { breadcrumbJsonLd } from "../../lib/seo/jsonld";
import { siteOrigin } from "../../lib/seo/meta";
import {
  getSeriesReviews,
  seriesCountText,
  seriesDescription,
  seriesIntro,
  seriesTitle,
} from "../../lib/seo/series-reviews";
import { currentTheme } from "../../lib/tmdb/discover";

let theme: string = "publication";
try {
  theme = await currentTheme();
} catch {
  theme = "publication";
}
const isDiscovery = theme === "discovery";

const brand = await getSiteBrand((k) => getSetting(getDb({}), k));
const origin = siteOrigin(Astro.url.origin);
const path = "/series";
const reviews = await getSeriesReviews(100);
const titleText = seriesTitle();
const descSource = seriesDescription(brand.name, reviews.length);
const countText = seriesCountText(reviews.length);
const intro = seriesIntro(brand.name, reviews.length);
const headingIsLong = titleText.length > 40;
// Nothing published = nothing to index. The page still renders.
const robots = reviews.length > 0 ? "index, follow" : "noindex, follow";
const jsonld = [
  breadcrumbJsonLd(origin, [
    { name: "Home", path: "/" },
    { name: "Series", path },
  ]),
];
if (reviews.length > 0) {
  jsonld.push({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: titleText,
    url: `${origin}${path}`,
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: reviews.length,
      itemListElement: reviews.map((r, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: r.reviewTitle,
        url: `${origin}/reviews/${r.slug}`,
      })),
    },
  });
}
---
<Base
  title={titleText}
  description={descSource}
  path={path}
  robots={robots}
  jsonld={jsonld}
  current="series"
>
  {isDiscovery ? (
  <div class="wrap">
    <section class="band section--md d-browse-head" aria-labelledby="series-title">
      <nav class="d-crumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true"> / </span><span aria-current="page">Series</span>
      </nav>
      <p class="d-kicker">Series</p>
      <h1 id="series-title" class={headingIsLong ? "display--long" : undefined}>{titleText}</h1>
      <p class="d-lede">{intro}</p>
    </section>

    {reviews.length > 0 ? (
      <section class="band--alt section--md d-results" aria-labelledby="series-list-heading">
        <div class="section-head d-section-row">
          <div>
            <h2 id="series-list-heading" class="tnum">{countText}</h2>
            <p>Newest first. Every entry is our own review.</p>
          </div>
        </div>
        <ol class="glam-archive">
          {reviews.map((r, i) => <SeriesReviewItem review={r} index={i} />)}
        </ol>
      </section>
    ) : (
      <section class="band section--sm" aria-label="No series reviews yet">
        <p>
          Nothing to list here yet. <a href="/reviews">Browse the review archive</a> instead.
        </p>
      </section>
    )}
  </div>
  ) : (
  <>
  <div class="wrap">
    <section aria-labelledby="series-title" class="band section--lg glam-archive-head">
      <div class="section-head">
        <p class="glam-kicker tnum">Series</p>
        <h1 id="series-title" class={headingIsLong ? "display--long" : undefined}>{titleText}</h1>
        <p class="tnum glam-archive-dek">{intro}</p>
      </div>
    </section>
  </div>

  {reviews.length > 0 ? (
    <div class="band section--md glam-archive-band">
      <div class="wrap">
        <ol class="glam-archive">
          {reviews.map((r, i) => <SeriesReviewItem review={r} index={i} />)}
        </ol>
      </div>
    </div>
  ) : (
    <div class="wrap">
      <p>
        Nothing to list here yet. <a href="/reviews">Browse the review archive</a> instead.
      </p>
    </div>
  )}
  </>
  )}
</Base>
