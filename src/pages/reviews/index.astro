---
/** Archive — full review index. Genre filters 301 to their category hub. */
import Base from "../../layouts/Base.astro";
import ReviewCard from "../../components/public/ReviewCard.astro";
import GenreNav from "../../components/public/GenreNav.astro";
import MovieTile from "../../components/discover/MovieTile.astro";
import { getSiteBrand } from "../../lib/seo/brand";
import { getDb, getSetting } from "../../lib/db/adapter";
import { breadcrumbJsonLd } from "../../lib/seo/jsonld";
import { siteOrigin } from "../../lib/seo/meta";
import { getLatestReviews, listGenres } from "../../lib/seo/content";
import { slugifyTaxonomy } from "../../lib/seo/taxonomy";
import { currentTheme } from "../../lib/tmdb/discover";

let theme: string = "publication";
try {
  theme = await currentTheme();
} catch {
  theme = "publication";
}
const isDiscovery = theme === "discovery";

const genre = Astro.url.searchParams.get("genre")?.trim() || null;
const genres = listGenres();
/**
 * One URL per genre. The old ?genre= view duplicated /category/<slug> with a
 * different title and no canonical of its own, so it now 301s to the hub.
 * An unknown value falls back to the archive rather than inventing a page.
 */
if (genre) {
  const slug = slugifyTaxonomy(genre);
  const known = genres.some((g) => slugifyTaxonomy(g) === slug);
  return Astro.redirect(known ? `/category/${slug}` : "/reviews", 301);
}
const brand = await getSiteBrand((k) => getSetting(getDb({}), k));
const origin = siteOrigin(Astro.url.origin);
const reviews = getLatestReviews(100);
const heading = "Every film review in the journal, newest first";
const titleText = "Movie reviews";
const descSource =
  "The complete review archive, newest first — every film covered in the journal.";
/**
 * The archive is a review index, so every tile points at the review's own
 * canonical URL. The /movies/<tmdbId> hub stays one click away from the
 * review page and from the homepage rails.
 */
const reviewHref = (r: (typeof reviews)[number]) => `/reviews/${r.slug}`;
const jsonld = [
  breadcrumbJsonLd(origin, [{ name: "Home", path: "/" }, { name: "Reviews", path: "/reviews" }]),
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: heading,
    url: `${origin}/reviews`,
    mainEntity: {
      "@type": "ItemList",
      itemListElement: reviews.map((r, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: r.movieTitle,
        url: `${origin}${reviewHref(r)}`,
      })),
    },
  },
];
const headingIsLong = heading.length > 40;
const countText =
  reviews.length === 1 ? "1 review" : `${reviews.length} reviews`;
---
<Base
  title={titleText}
  description={descSource}
  descriptionExtra="Browse the full collection by genre — horror, drama, comedy, and more, every entry rated by the editor out of ten."
  path="/reviews"
  jsonld={jsonld}
  current="reviews"
>
  {isDiscovery ? (
  <div class="wrap">
    <section class="band section--md d-browse-head" aria-labelledby="archive-title">
      <nav class="d-crumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true"> / </span><span aria-current="page">Reviews</span>
      </nav>
      <p class="d-kicker">The archive</p>
      <h1 id="archive-title" class={headingIsLong ? "display--long" : undefined}>{heading}</h1>
      <p class="d-lede tnum">
        {countText}, newest first.
      </p>
      <GenreNav genres={genres} />
    </section>

    {reviews.length > 0 ? (
      <section class="band--alt section--md d-results" aria-labelledby="d-results-heading">
        <div class="section-head d-section-row">
          <div>
            <h2 id="d-results-heading" class="tnum">{countText}</h2>
            <p>Every review, newest first.</p>
          </div>
        </div>
        <ol class="d-guide-grid">
          {reviews.map((r, i) => (
            <MovieTile
              tmdbId={r.tmdbId ?? -1}
              title={r.movieTitle}
              year={r.year}
              posterUrl={r.posterUrl}
              rating={r.rating}
              source="ours"
              href={reviewHref(r)}
              variant="compact"
              eager={i === 0}
            />
          ))}
        </ol>
      </section>
    ) : (
      <section class="band section--sm" aria-label="No reviews">
        <p>
          Nothing filed here yet. <a href="/reviews">Back to the full archive</a>.
        </p>
      </section>
    )}
  </div>
  ) : (
  <>
  <div class="wrap">
    <section aria-labelledby="archive-title" class="band section--lg glam-archive-head">
      <div class="section-head">
        <p class="glam-kicker tnum">The archive</p>
        <h1 id="archive-title" class={headingIsLong ? "display--long" : undefined}>{heading}</h1>
        <p class="tnum glam-archive-dek">
          {reviews.length} {reviews.length === 1 ? "review" : "reviews"}, newest first.
        </p>
      </div>
      <GenreNav genres={genres} />
    </section>
  </div>

  {reviews.length > 0 ? (
    <div class="band section--md glam-archive-band">
      <div class="wrap">
        <ol class="glam-archive">
          {reviews.map((r, i) => i === 0
            ? <ReviewCard review={r} index={i} variant="archive-lead" />
            : <ReviewCard review={r} index={i} variant="archive-cell" />)}
        </ol>
      </div>
    </div>
  ) : (
    <div class="wrap">
      <p>
        Nothing filed here yet. <a href="/reviews">Back to the full archive</a>.
      </p>
    </div>
  )}
  </>
  )}
</Base>
