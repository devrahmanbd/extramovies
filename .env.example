# --- SYSTEM ONLY (.env) ---
# Everything else (TMDB, OMDb, OpenRouter, site/brand/region/SEO, taste)
# lives in the `settings` table and is edited at /admin/settings.
# Env vars below are bootstrap fallbacks used only when the dashboard
# has no value saved yet (first boot / CI). Dashboard always wins after save.

# Admin bootstrap (hashed on first run; never commit real values)
ADMIN_EMAIL=editor@example.com
ADMIN_PASSWORD=change-me-in-production

# Local SQLite file (Node/cPanel). Cloudflare Workers uses the D1 binding instead.
DB_FILE=./data/local.db

# Session signing / cookie encryption (generate: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-long-random-string

# --- Deploy-time website theme (one deployment = one theme) ---
# SITE_THEME=publication|discovery
#   publication = personal review magazine (default)
#   discovery   = movie discovery + streaming guide
# Set this for a fixed theme. Or leave it unset and choose once in the
# first-run wizard at /setup, which writes site.theme once.
# NOTE: /setup never overwrites an existing site.theme value — the choice
# is permanent for the install and there is no theme switcher.

# Deploy-time frontend theme (no dashboard switcher): discovery | publication.
# Default is publication when unset. Deployment A sets discovery,
# Deployment B sets publication (or leaves unset). Same engine/data,
# independent frontends.
SITE_THEME=publication
