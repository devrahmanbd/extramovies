# Secrets — never commit
.env
.env.local
*.pem
*.key

# Runtime data
data/*.db
data/*.db-*
data/settings.json
data/reviews.json
data/seed-refresh.json
data/uploads/
data/legacy/

# Build output
dist/
.astro/
.wrangler/

# Deps
node_modules/

# OS
.DS_Store

scripts/legacy/__pycache__/
scripts/seo/__pycache__/

# GSC service-account key safety net (never commit a key)
*.gsc-sa*.json

# Server edge config, CI-managed (deploy.yml step 6b). Never tracked: a
# tracked .htaccess would collide with any panel-written file on the
# server and abort `git pull` mid-deploy.
.htaccess
